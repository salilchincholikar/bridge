setting = before-any-section
[default]
region = eu-west-1
this line has no equals sign

[profile cycle-a]
role_arn = arn:aws:iam::555555555555:role/A
source_profile = cycle-b

[profile cycle-b]
role_arn = arn:aws:iam::555555555555:role/B
source_profile = cycle-a

[profile dangling]
role_arn = arn:aws:iam::555555555555:role/C
source_profile = does-not-exist

[profile no-session]
sso_session = nope
sso_account_id = 666666666666
sso_role_name = X

[profile dup]
region = us-east-1
[profile dup]
region = us-west-1

[profile unterminated
region = eu-west-1
