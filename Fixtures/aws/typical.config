# Fixture: invented accounts and values only. Not anyone's real config.
[default]
region = eu-west-1
output = json

[profile example-dev]
sso_session = corp
sso_account_id = 111111111111
sso_role_name = Developer
region = eu-west-1

[profile example-prod]
sso_session = corp
sso_account_id = 222222222222
sso_role_name = ReadOnly
region = eu-west-1

[sso-session corp]
sso_start_url = https://example.awsapps.com/start
sso_region = eu-west-1
sso_registration_scopes = sso:account:access

[profile admin-via-example-dev]
role_arn = arn:aws:iam::333333333333:role/ops/Admin
source_profile = example-dev
region = eu-west-1

[profile legacy]
sso_start_url = https://legacy.awsapps.com/start
sso_region = us-east-1
sso_account_id = 444444444444
sso_role_name = Legacy

[profile proc]
credential_process = /usr/local/bin/get-creds --profile proc
region = us-east-2

[profile keys]
aws_access_key_id = AKIAFAKEFAKEFAKEFAKE
aws_secret_access_key = fake-secret-for-tests-only
aws_session_token = fake-token-for-tests-only
region = us-east-1

[profile nested]
region = us-west-2
s3 =
  max_concurrent_requests = 20
  max_queue_size = 10000

[profile "quoted name"]
region = ap-south-1

[services example]
dynamodb =
  endpoint_url = http://localhost:8000
